# ===== Azure AD / Entra ID =====
VITE_AZURE_CLIENT_ID=your-client-id
VITE_AZURE_TENANT_ID=your-tenant-id

# ===== Demo Mode (kiểm tra UI không cần backend) =====
# VITE_DEMO_MODE=true → bỏ qua Entra ID / SharePoint / Power Automate,
# dùng dữ liệu mẫu + công tắc đổi role ngay trên header.
VITE_DEMO_MODE=true

# Base URL của site SharePoint chứa các List (dùng cho Graph API /upload trực tiếp)
# Ví dụ: https://contoso.sharepoint.com/sites/ITSupport
VITE_SHAREPOINT_SITE_HOST=https://yourtenant.sharepoint.com
VITE_SHAREPOINT_SITE_PATH=/sites/ITSupport

# ===== Power Automate — HTTP trigger URLs (Azure AD auth) =====
# Mỗi flow xử lý 1 thao tác, đọc/ghi SharePoint List
VITE_FLOW_GET_USER_ROLE=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_CREATE_TICKET=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_GET_TICKETS=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_GET_TICKET=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_UPDATE_STATUS=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_REQUEST_MORE_INFO=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_ADD_COMMENT=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_GET_COMMENTS=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_MARK_READ=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
VITE_FLOW_ASSIGN_IT=https://prod-00.westus.logic.azure.com/workflows/.../triggers/manual/paths/invoke?...
